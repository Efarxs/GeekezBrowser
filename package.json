{
  "name": "geekez-browser",
  "version": "1.7.14",
  "description": "Stealthy Anti-Detect Browser for E-Commerce",
  "main": "out/main/index.js",
  "author": "EchoHS",
  "scripts": {
    "dev": "chcp 65001 >nul && electron-vite dev",
    "predev": "node scripts/ensure-native-abi.mjs",
    "build": "electron-vite build",
    "postinstall": "node setup.js && npx @electron/rebuild -f -w better-sqlite3",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "postbuild:win": "node scripts/ensure-native-abi.mjs --restore",
    "postbuild:mac": "node scripts/ensure-native-abi.mjs --restore",
    "postbuild:linux": "node scripts/ensure-native-abi.mjs --restore",
    "test": "node --test scripts/*.test.mjs",
    "test:api": "node scripts/api-smoke.mjs"
  },
  "build": {
    "appId": "com.geekez.browser",
    "productName": "GeekEZ Browser",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.test.js",
      "!**/*.spec.js"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/logo.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "src/renderer/icon.png"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 100,
          "type": "file",
          "path": "resources/使用说明.txt"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/renderer/icon.png"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fs-extra": "^11.3.4",
    "get-port": "^7.2.0",
    "js-base64": "^3.7.8",
    "js-yaml": "^4.1.1",
    "pinia": "^3.0.4",
    "socks-proxy-agent": "^10.0.0",
    "tcp-ping": "^0.1.1",
    "tree-kill": "^1.2.2",
    "uuid": "^13.0.0",
    "vue": "^3.5.31",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.1"
  },
  "optionalDependencies": {
    "mysql2": "^3.14.1",
    "pg": "^8.16.0"
  }
}
